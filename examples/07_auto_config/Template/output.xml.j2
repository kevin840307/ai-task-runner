    {% if app_config is mapping %}
      {% for key, value in app_config.items() %}
      <{{ key }}>{{ value }}</{{ key }}>
      {% endfor %}
    {% elif app_config is sequence %}
      {% for version in app_config %}
      <version>{{ version.name }}</version>
      <resource>
        {% for key, value in version.resource.items() %}
        <{{ key }}>{{ value }}</{{ key }}>
        {% endfor %}
      </resource>
      {% endfor %}
    {% endif %}
    {% endfor %}
  </flow-deploy>
  <__merge_probe__>
    <kept>{{ config.__merge_probe__.kept }}</kept>
    <nested>{{ config.__merge_probe__.nested }}</nested>
    <list_value>{{ config.__merge_probe__.list_value }}</list_value>
