# Auto-generated configuration file
# Generated by rander.py from config values

fab: {{ config.target.family }}
gateway: {{ config.gateway.base }}
namespace:
  name: {{ config.namespace.name }}
app-deploy:
{% for app_name, app_config in config.app_deploy.items() %}
  {{ app_name }}:
    {% if app_config is mapping %}
      {% for key, value in app_config.items() %}
      {{ key }}: {{ value }}
      {% endfor %}
    {% elif app_config is sequence %}
      {% for version in app_config %}
      - name: {{ version.name }}
        resource:
          {% for key, value in version.resource.items() %}
          {{ key }}: {{ value }}
          {% endfor %}
      {% endfor %}
    {% endif %}
{% endfor %}

flow-deploy:
{% for app_name, app_config in config.flow_deploy.items() %}
  {{ app_name }}:
    {% if app_config is mapping %}
      {% for key, value in app_config.items() %}
      {{ key }}: {{ value }}
      {% endfor %}
    {% elif app_config is sequence %}
      {% for version in app_config %}
      - name: {{ version.name }}
        resource:
          {% for key, value in version.resource.items() %}
          {{ key }}: {{ value }}
          {% endfor %}
      {% endfor %}
    {% endif %}
{% endfor %}

__merge_probe__:
  kept: {{ config.__merge_probe__.kept }}
  nested: {{ config.__merge_probe__.nested }}
  list_value: {{ config.__merge_probe__.list_value }}
  empty_dict_value: {}
  null_value: null
